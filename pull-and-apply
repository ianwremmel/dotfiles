#!/usr/bin/env bash
# Pull the latest dotfiles (and any custom_environments repos), then apply.
# Invoked over SSH by a paired client's post-apply fan-out (see lib/nix's
# _dotfiles_nix_fanout). DOTFILES_REMOTE_TRIGGER=1 marks the downstream apply
# so it does not fan out again — no loops.
set -euo pipefail

cd "$(dirname "$0")"

# --ff-only: never create a merge commit on a remote with local commits; a
# diverged remote fails here and surfaces as "apply failed" in the client's
# fan-out summary rather than silently merging.
git pull --ff-only

# custom_environments is itself one private repo (its .git is at the top of that
# directory, not inside each env), so pull it directly. The per-env loop below
# only ever matched a nested checkout, which meant the private config was never
# refreshed and an apply could build new public core against stale private
# modules — the settings merge cannot delete, so a key the new core stopped
# declaring kept its old value silently. Fail hard instead of warning: applying
# a half-updated config is worse than not applying.
if [ -d custom_environments/.git ]; then
  ( cd custom_environments && git pull --ff-only )
fi

# A private env may itself nest a further checkout; pull those too.
for d in custom_environments/*/; do
  if [ -d "$d.git" ]; then
    ( cd "$d" && git pull --ff-only )
  fi
done

exec env DOTFILES_REMOTE_TRIGGER=1 ./apply
